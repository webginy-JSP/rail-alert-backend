# Neon(Postgres) 대시보드에서 복사한 연결 문자열 두 개
# DATABASE_URL: pooled connection (호스트에 -pooler 포함, 끝에 &pgbouncer=true&connect_timeout=15 추가)
# DIRECT_URL: 마이그레이션 전용 direct connection (호스트에 -pooler 없음)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"
PORT=4000

# 개인용 API 키 - 앱과 서버가 통신할 때 헤더(x-api-key)로 확인
API_KEY="change-me-to-a-random-string"

# 모니터링 엔진 조회 주기 (초). 너무 짧게 잡지 마세요 (레이트리밋 위험)
MONITOR_INTERVAL_SECONDS=30

# Firebase 프로젝트에서 발급받은 서비스 계정 JSON 파일 경로
# (실제 푸시를 보내려면 필요. 없으면 콘솔 로그로만 동작)
FIREBASE_SERVICE_ACCOUNT_PATH=""
